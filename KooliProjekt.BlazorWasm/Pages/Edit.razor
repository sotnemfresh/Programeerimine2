@page "/create"
@page "/edit/{Id:int}"

@inject KooliProjekt.BlazorWasm.IApiClient apiClient
@inject NavigationManager NavManager

<h3>@title</h3>

<EditForm EditContext="editContext" OnValidSubmit="@FormSubmitted">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <p class="alert-danger">@error</p>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">ID</label>
        <div class="col-sm-10">
            @toode.Id
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Name</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="toode.Name" />
            <ValidationMessage For="@(() => toode.Name)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Description</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="toode.Description" />
            <ValidationMessage For="@(() => toode.Description)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Foto URL</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="toode.FotoURL" />
            <ValidationMessage For="@(() => toode.FotoURL)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Price</label>
        <div class="col-sm-10">
            <InputNumber class="form-control" @bind-Value="toode.Price" />
            <ValidationMessage For="@(() => toode.Price)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Stock Quantity</label>
        <div class="col-sm-10">
            <InputNumber class="form-control" @bind-Value="toode.StockQuantity" />
            <ValidationMessage For="@(() => toode.StockQuantity)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label"></label>
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }

    private string error = "";
    private string title = "Edit";
    private EditContext? editContext;
    private Toode toode = new Toode();
    private ValidationMessageStore? messageStore;

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(toode);
        messageStore = new ValidationMessageStore(editContext);

        if (Id == 0)
        {
            title = "Add";
            return;
        }

        var response = await apiClient.Get(Id);
        if (!response.HasErrors)
        {
            toode = response.Value;
            editContext = new EditContext(toode);
            messageStore = new ValidationMessageStore(editContext);
        }
    }

    private async Task FormSubmitted()
    {
        // Eemalda eelnevad veateated
        messageStore?.Clear();

        var result = await apiClient.Save(toode);
        if (!result.HasErrors)
        {
            NavManager.NavigateTo("/tooted");
            return;
        }

        foreach (var error in result.Errors)
        {
            messageStore?.Add(new FieldIdentifier(toode, string.Empty), error);
        }

        foreach (var error in result.PropertyErrors)
        {
            var propertyName = error.Key[0].ToString().ToUpper() + error.Key.Substring(1);
            messageStore?.Add(new FieldIdentifier(toode, propertyName), error.Value);
        }

        // Teavita EditForm'i, et vead on muutunud
        editContext?.NotifyValidationStateChanged();
    }
}
